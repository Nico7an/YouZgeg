*.apkm
*.xapk

# Jars and libraries
*.jar
libs/

# Downloaded official patches bundle (dynamic)
patches-*.mpp
patches.mpp

# Morphe temp data
morphe-data/
.build_tmp/
temp/

# OS / Editor files
.DS_Store
*.log
